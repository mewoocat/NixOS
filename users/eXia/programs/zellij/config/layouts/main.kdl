layout {

  // This declares the default behavior for each tab node
  default_tab_template {
    pane size=1 borderless=true {
        plugin location="tab-bar"
    }
    children
    pane size=1 borderless=true {
        plugin location="status-bar"
    }
  }

  tab name="NixOS | cli" {
    pane {
    }
  }
  tab name="NixOS | editor" cwd="~/NixOS" {
    pane command="vi" {
    }
  }

  tab name="leaf | cli" cwd="~/Projects/LeafShell/" {
    pane {
    }
  }

  tab name="leaf | editor" cwd="~/Projects/LeafShell/" {
    pane command="vi" {
    }
  }
 
  tab
    name="nix repl"
    cwd="~/NixOS"
  {
    pane
      command="btop"
    { }
  }

  tab name="btop" { pane command="btop" {} }
}
