layout {

  // This declares the default behavior for each tab node
  default_tab_template {
    pane size=1 borderless=true {
        plugin location="tab-bar"
    }
    children
    pane size=1 borderless=true {
        plugin location="status-bar"
    }
  }

  tab name="NixOS | cli" {
    pane {
    }
  }
  tab name="NixOS | editor" cwd="~/NixOS" {
    pane command="vi" {
    }
  }

  tab name="Quickshell | cli" cwd="~/NixOS/modules/system/desktop-environments/leaf/quickshell/" {
    pane {
    }
  }

  tab name="Quickshell | editor" cwd="~/NixOS/modules/system/desktop-environments/leaf/quickshell/" {
    pane command="vi" {
    }
  }
 
  tab name="btop" {
    pane command="btop" {}

  }
}
